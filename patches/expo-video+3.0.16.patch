+  private fun updateFrameRateMatch() {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return
+    val surfaceView = playerView.videoSurfaceView as? SurfaceView ?: return
+    val player = videoPlayer ?: return
+    val frameRate = player.currentVideoTrack?.frameRate ?: player.availableVideoTracks.firstOrNull()?.frameRate

+    if (frameRate == null || !frameRate.isFinite() || frameRate <= 0f) {
+      clearFrameRateMatch()
+      return
+    }

+    if (lastAppliedFrameRate == frameRate) return

+    val surface = surfaceView.holder.surface
+    if (!surface.isValid) return

+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+        surface.setFrameRate(
+          frameRate,
+          Surface.FRAME_RATE_COMPATIBILITY_FIXED_SOURCE,
+          Surface.CHANGE_FRAME_RATE_ONLY_IF_SEAMLESS
+        )
+      } else {
+        surface.setFrameRate(frameRate, Surface.FRAME_RATE_COMPATIBILITY_FIXED_SOURCE)
+      }
+      lastAppliedFrameRate = frameRate
+    } catch (_: Throwable) {
+      // Best-effort only.
+    }
+  }

+  private fun clearFrameRateMatch() {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return
+    val surfaceView = playerView.videoSurfaceView as? SurfaceView ?: run {
+      lastAppliedFrameRate = null
+      return
+    }
+    val surface = surfaceView.holder.surface
+    if (!surface.isValid) {
+      lastAppliedFrameRate = null
+      return
+    }

+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+        surface.setFrameRate(
+          0f,
+          Surface.FRAME_RATE_COMPATIBILITY_DEFAULT,
+          Surface.CHANGE_FRAME_RATE_ONLY_IF_SEAMLESS
+        )
+      } else {
+        surface.setFrameRate(0f, Surface.FRAME_RATE_COMPATIBILITY_DEFAULT)
+      }
+    } catch (_: Throwable) {
+      // Best-effort only.
+    } finally {
+      lastAppliedFrameRate = null
+    }
+  }
